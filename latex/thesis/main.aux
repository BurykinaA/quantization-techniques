\@writefile{toc}{\contentsline {subsubsection}{\numberline {5.3.4}INT4: Diagonal Placement, MLP Decomposition, and Staged Training}{21}{subsubsection.5.3.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces $\alpha $-mixing sweep at 1024 calibration samples. ADC PPL is minimised at $\alpha = 0.5$; smaller values under-weight the ADC regime, larger values amplify gradient noise from the floor operator and degrade bypass PPL.}}{22}{figure.caption.29}\protected@file@percent }
\newlabel{fig:alpha_sweep}{{5}{22}{$\alpha $-mixing sweep at 1024 calibration samples. ADC PPL is minimised at $\alpha = 0.5$; smaller values under-weight the ADC regime, larger values amplify gradient noise from the floor operator and degrade bypass PPL}{figure.caption.29}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Loss-landscape visualisation around the converged transforms for $\alpha \in \{0, 0.5, 1\}$ via filter-normalised random perturbations. The $\alpha = 0.5$ minimum is the widest and flattest, indicating that mixed FP/ADC calibration finds smoother solutions than either extreme.}}{22}{figure.caption.30}\protected@file@percent }
\newlabel{fig:loss_landscape}{{6}{22}{Loss-landscape visualisation around the converged transforms for $\alpha \in \{0, 0.5, 1\}$ via filter-normalised random perturbations. The $\alpha = 0.5$ minimum is the widest and flattest, indicating that mixed FP/ADC calibration finds smoother solutions than either extreme}{figure.caption.30}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces INT4 diagonal placement and staged training. 1024 samples, $\alpha =0.5$.}}{22}{table.caption.31}\protected@file@percent }
\newlabel{tab:int4v3v4}{{5}{22}{INT4 diagonal placement and staged training. 1024 samples, $\alpha =0.5$}{table.caption.31}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Roles of the MLP and attention diagonals. The MLP diagonal drives bypass-PPL improvements (transform quality); the attention diagonal closes the bypass--ADC gap (robustness to ADC noise). Either alone leaves significant perplexity on the table; staged training combines both.}}{23}{figure.caption.32}\protected@file@percent }
\newlabel{fig:diag_roles}{{7}{23}{Roles of the MLP and attention diagonals. The MLP diagonal drives bypass-PPL improvements (transform quality); the attention diagonal closes the bypass--ADC gap (robustness to ADC noise). Either alone leaves significant perplexity on the table; staged training combines both}{figure.caption.32}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces MLP-diagonal decomposition. \texttt  {down\_proj} contributes nearly all of the bypass improvement; the \texttt  {up}/\texttt  {gate} diagonal contributes little, since \texttt  {down\_proj} sits immediately before the next ADC accumulation and shapes the signal that is read.}}{23}{figure.caption.33}\protected@file@percent }
\newlabel{fig:mlp_split}{{8}{23}{MLP-diagonal decomposition. \texttt {down\_proj} contributes nearly all of the bypass improvement; the \texttt {up}/\texttt {gate} diagonal contributes little, since \texttt {down\_proj} sits immediately before the next ADC accumulation and shapes the signal that is read}{figure.caption.33}{}}
