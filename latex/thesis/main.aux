\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Step-by-step INT4 PTQ progression. Each step targets one failure mode: 128 samples (catastrophic, ADC PPL~2355); propagation $+$ 1024 samples (40.6); partial $\alpha =0.5$ mixing and bounded diagonals (27.56); staged training (27.60 with cleanest bypass~18.50). FP baseline and INT8-prop+centre reference lines are shown.}}{21}{figure.caption.27}\protected@file@percent }
\newlabel{fig:int4_ptq_progression}{{4}{21}{Step-by-step INT4 PTQ progression. Each step targets one failure mode: 128 samples (catastrophic, ADC PPL~2355); propagation $+$ 1024 samples (40.6); partial $\alpha =0.5$ mixing and bounded diagonals (27.56); staged training (27.60 with cleanest bypass~18.50). FP baseline and INT8-prop+centre reference lines are shown}{figure.caption.27}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {5.3.3}INT4: $\alpha $-Mixing Sweep (1024 Samples)}{21}{subsubsection.5.3.3}\protected@file@percent }
